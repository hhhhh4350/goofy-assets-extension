{
	"manifest_version": 3,
	"name": "Anniversary Assets",
	"description": "Happy 10 years Deeeep.io!",
	"version": "1.0.43",
	"icons": {
		"128": "Docassetsicon.png"
	},

	"action": {
		"default_icon": {
			"128": "Docassetsicon.png"
		},
		"default_title": "Click to turn Anniversary Assets on/off"
	},
	"background": {
		"service_worker": "background.js"
	},
	"host_permissions": [
		"https://deeeep.io/*",
		"https://alpha.deeeep.io/*",
		"https://beta.deeeep.io/*",
		"https://cdn.deeeep.io/*",
		"https://mapmaker.deeeep.io/*"
	],
	"permissions": ["scripting", "storage"]
}
